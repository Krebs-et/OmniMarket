# PostgreSQL gestionado: RDS/Aurora, Railway o cualquier PostgreSQL compatible.
# Para RDS usa el endpoint DNS, no una IP fija. Mantén sslmode=require.
DATABASE_URL=postgres://omnimarket_app:CHANGE_ME@your-rds-endpoint:5432/omnimarket?sslmode=require
APP_ENV=production
AUTH_SECRET=generate-a-long-random-value
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=changeme
DB_POOL_MAX=1
